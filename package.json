{
  "name": "hevier-repo",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "vitest run --coverage",
    "check": "turbo run check",
    "mobile": "pnpm --filter @hevier/mobile start",
    "android": "pnpm --filter @hevier/mobile android",
    "sync": "pnpm --filter @hevier/sync start",
    "web": "pnpm --filter @hevier/web dev",
    "e2e": "turbo run e2e --filter=@hevier/web",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "turbo": "^2.5.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
